      m_Calls: []
  m_text: "<color=#5EC8E5><b>TEAM</b></color>\nAdrian Robles \xB7 Diego Esparza \u2014 NASA Space Apps Challenge 2026\n\n<color=#5EC8E5><b>MARS IMAGERY</b></color>\nNASA/JPL-Caltech, MSSS, University of Arizona (HiRISE), Arizona State University (THEMIS), ASI (SHARAD) and JHUAPL (CRISM). Mars and Earth textures: Solar System Scope (CC BY 4.0).\n\n<color=#5EC8E5><b>STARS</b></color>\nDeep Star Maps 2020: NASA/Goddard Space Flight Center Scientific Visualization Studio. Gaia DR2: ESA/Gaia/DPAC.\n\n<color=#5EC8E5><b>3D MODELS</b></color>\nNASA 3D Resources: Mars Reconnaissance Orbiter, Magellan, Chandra, Aquarius, LLCD and Space Launch System. Instruments: the team's own kit.\n\n<color=#5EC8E5><b>AUDIO</b></color>\nMusic, sound effects and voices generated with ElevenLabs.\n\n<color=#5EC8E5><b>FONTS AND ICONS</b></color>\nRajdhani, Barlow and IBM Plex Mono (SIL OFL 1.1). Lucide icons (ISC).\n\n<color=#94A3B8>NASA does not sponsor or endorse this game. Mass, power and cost values are fictional. Full details in CREDITOS.md.</color>"
  m_isRightToLeft: 0
