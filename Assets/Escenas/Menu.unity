  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<color=#5EC8E5>\uE3E7</color>  Elige una \xF3rbita, un lanzador y los instrumentos cient\xEDficos.\n<color=#5EC8E5>\uE530</color>  No te pases de los l\xEDmites de masa, potencia, presupuesto y espacios.\n<color=#5EC8E5>\uE226</color>  El sem\xE1foro te avisa si puedes lanzar y si te falta alguna evidencia.\n<color=#5EC8E5>\uE448</color>  Al lanzar, sigue las transmisiones de la nave y recibe un informe que explica el resultado."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8ffc11dc04732f67e805ef02f556252d, type: 2}
  m_sharedMaterial: {fileID: 4039928615207978615, guid: 8ffc11dc04732f67e805ef02f556252d, type: 2}
