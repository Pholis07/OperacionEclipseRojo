  id: micrometeorito
  nombre: "Micrometeorite impact"
  texto: "A micrometeorite damages a solar panel circuit. The spacecraft produces less power until the current is rerouted."
  efecto: 1
  vatios: 200
  orbitas: 0
  herramientaId: reconfiguracion
  puntos: 0
  opciones:
  - texto: "Use the power reconfiguration"
    efecto: 0
    combustible: 0
    orbitas: 0
    duracion: 0
  - texto: "Reroute the current by hand (next month loses 10 days)"
    efecto: 1
    combustible: 0
    orbitas: 1
    duracion: 0
  - texto: "Carry on with less power until the end"
    efecto: 3
    combustible: 0
    orbitas: 0
    duracion: 0
